# Скопіюйте цей файл у .env і підставте власні значення. Файл .env не комітиться (див. .gitignore).
# На Render ті самі змінні задаються у вкладці Environment сервісу.

# База даних: PostgreSQL на Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Порт. Локально 5000. На Render порт виставляє платформа, у змінні його не додавайте
PORT=5000

# Firebase Admin. Локально сервер читає файл firebase-admin.json із папки server.
# На хмарі замість файлу задайте змінну FIREBASE_CREDENTIALS: весь вміст JSON-ключа одним рядком
# FIREBASE_CREDENTIALS=

# Cloudinary (фото чеків)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OCR.space (розпізнавання чеків)
OCR_SPACE_API_KEY=

# Дозволені адреси вебклієнта через кому (CORS). На Render додайте адресу клієнта https://….onrender.com
CORS_ORIGINS=http://localhost:5173

# Ліміт запитів на IP за 15 хвилин
RATE_LIMIT_MAX=600

# За reverse-proxy (Render) потрібно TRUST_PROXY=1, інакше rate limit бачитиме IP проксі
# TRUST_PROXY=1

# Google Gemini (AI-помічник). Ключ створюється в Google AI Studio: aistudio.google.com/apikey
GEMINI_API_KEY=
# Модель Gemini. Доступні моделі та безкоштовні ліміти дивіться в AI Studio (сторінка Rate limit)
GEMINI_MODEL=gemini-3.1-flash-lite
# Необов'язково: таймаут відповіді AI у мс (за замовчуванням 25000) і ліміт запитів до /api/ai на IP за 15 хвилин (за замовчуванням 30)
# AI_TIMEOUT_MS=25000
# AI_RATE_LIMIT=30
